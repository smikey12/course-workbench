{
  "manifest_version": 3,
  "name": "课藏 · 平台连接",
  "version": "0.5.1",
  "description": "连接本机课藏与已授权的课程平台，只读同步课程和作业元数据；需另行运行本机工作台。",
  "permissions": [
    "alarms",
    "offscreen",
    "scripting",
    "storage"
  ],
  "optional_host_permissions": [
    "https://mooc1-api.chaoxing.com/*",
    "https://mooc1.chaoxing.com/*",
    "https://mooc2-ans.chaoxing.com/*",
    "https://www.icourse163.org/*",
    "https://www.yuketang.cn/*",
    "https://pintia.cn/*"
  ],
  "options_page": "cx-access.html",
  "host_permissions": [
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "课藏 · 课程同步",
    "default_popup": "cx-access.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1:8765/*"
      ],
      "js": [
        "workbench-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
